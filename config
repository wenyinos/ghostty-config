# ===== 基本设置 / Basic Settings =====

# 终端窗口标题 / Terminal window title
title = Ghostty

# 设置 shell 集成模式为 zsh，用于自动命令补全、历史记录等
# Set shell integration mode to zsh for auto-completion, history, etc.
shell-integration = zsh

# 允许程序写入系统剪贴板 / Allow programs to write to clipboard
clipboard-write = allow

# 启用选中文本时自动复制（类似中键粘贴行为）
# Auto-copy text when selected (like middle-click paste behavior)
copy-on-select = true

# ===== 字体与标题栏 / Font & Title Bar =====

# 窗口标题栏使用的字体 / Font used in window title bar
window-title-font-family = Cascadia Code

# 窗口副标题显示内容：当前工作目录
# Window subtitle content: current working directory
window-subtitle = working-directory

# ===== 背景与透明度 / Background & Transparency =====

# 背景透明度（0.0-1.0，越小越透明）
# Background opacity (0.0-1.0, lower is more transparent)
background-opacity = 0.85

# 背景模糊半径（像素） / Background blur radius (in pixels)
background-blur = 20

# 未聚焦的分割窗口透明度 / Unfocused split window opacity
unfocused-split-opacity = 0.80

# ===== 窗口尺寸与样式 / Window Size & Style =====

# 窗口初始高度（字符行数） / Initial window height (in character rows)
window-height = 30

# 窗口初始宽度（字符列数） / Initial window width (in character columns)
window-width = 120

# 窗口装饰类型：client 表示使用客户端自定义装饰
# Window decoration type: client means client-side custom decoration
window-decoration = client

# ===== 主题与颜色 / Theme & Colors =====

# 使用的颜色主题 / Color theme to use
theme = TokyoNight Moon

# 启用粗体文字时同时增亮颜色
# Brighten colors when using bold text
bold-is-bright = true

# 最小对比度（辅助功能，确保文字与背景有足够对比度）
# Minimum contrast (accessibility, ensure sufficient text/background contrast)
minimum-contrast = 2.1

# 背景颜色 / Background color
background = #222436

# 前景（文字）颜色 / Foreground (text) color
foreground = #c8d3f5

# 选中文本的背景颜色 / Background color for selected text
selection-background = #2d3f76

# 选中文本的前景色 / Foreground color for selected text
selection-foreground = #c8d3f5

# 光标颜色 / Cursor color
cursor-color = #c8d3f5

# 光标下方的文字颜色 / Text color under cursor
cursor-text = #222436

# 光标透明度（0.0-1.0） / Cursor opacity (0.0-1.0)
cursor-opacity = 0.9

# ===== 调色板设置 (16色) / Palette Settings (16 colors) =====
# 0-7 为正常颜色，8-15 为明亮颜色
# 0-7 are normal colors, 8-15 are bright colors
# 格式 / Format: palette = 索引=颜色值 / index=color

palette = 0=#1b1d2b  # 黑色 / Black
palette = 1=#ff757f  # 红色 / Red
palette = 2=#c3e88d  # 绿色 / Green
palette = 3=#ffc777  # 黄色 / Yellow
palette = 4=#82aaff  # 蓝色 / Blue
palette = 5=#c099ff  # 品红色 / Magenta
palette = 6=#86e1fc  # 青色 / Cyan
palette = 7=#828bb8  # 白色 / White
palette = 8=#444a73  # 明亮黑 / Bright Black
palette = 9=#ff757f  # 明亮红 / Bright Red
palette = 10=#c3e88d # 明亮绿 / Bright Green
palette = 11=#ffc777 # 明亮黄 / Bright Yellow
palette = 12=#82aaff # 明亮蓝 / Bright Blue
palette = 13=#c099ff # 明亮品红 / Bright Magenta
palette = 14=#86e1fc # 明亮青 / Bright Cyan
palette = 15=#c8d3f5 # 明亮白 / Bright White

# ===== 字体设置 / Font Settings =====

# 字体大小 / Font size
font-size = 12

# 默认字体系列 / Default font family
font-family = Cascadia Code

# 粗体字体系列 / Bold font family
font-family-bold = Cascadia Code

# 斜体字体系列 / Italic font family
font-family-italic = Cascadia Code

# 粗斜体字体系列 / Bold italic font family
font-family-bold-italic = Cascadia Code

# 字体字形映射（空表示使用默认映射）
# Font codepoint mapping (empty means use default mapping)
font-codepoint-map =

# 字体样式 - 粗体 / Font style - Bold
font-style-bold = Bold

# 字体样式 - 斜体 / Font style - Italic
font-style-italic = Italic

# 字体样式 - 粗斜体 / Font style - Bold Italic
font-style-bold-italic = Bold Italic

# ===== 鼠标行为 / Mouse Behavior =====

# 输入时隐藏鼠标指针 / Hide mouse cursor while typing
mouse-hide-while-typing = true

# ===== GTK 设置 (Linux) / GTK Settings (Linux) =====

# GTK 工具栏样式：flat 为扁平样式
# GTK toolbar style: flat is flat style
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-titlebar = true
gtk-titlebar-hide-when-maximized = true
macos-non-native-fullscreen = visible-menu

# macOS 标题栏样式：tabs 使用标签页式样
# macOS title bar style: tabs uses tab-style appearance
macos-titlebar-style = tabs

# ===== 更新设置 / Update Settings =====

# 自动更新：check 表示仅检查不自动安装
# Auto update: check means only check without auto installing
auto-update = check

# 更新通道：stable 为稳定版 / Update channel: stable for stable releases
auto-update-channel = stable

#### Shaders ####
# CRT 着色器模拟复古显示器（故障、发光、点阵等效果）
# CRT shader emulates a retro CRT (glitches, glowing, dot matrix, etc...)

# 自定义着色器（CRT 效果模拟复古显示器）
# Custom shader (CRT effect emulating retro display)
#custom-shader = shaders/crt.glsl
