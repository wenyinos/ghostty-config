# ========================================
# Ghostty 配置文件 / Ghostty Configuration File
# ========================================

# ----------------------------------------
# 窗口设置 / Window Settings
# ----------------------------------------

# 窗口标题 / Window title
title = Ghostty

# 终端 shell 集成 / Shell integration
shell-integration = zsh

# 窗口标题栏字体 / Window title bar font
window-title-font-family = Cascadia Code

# 窗口副标题显示内容 / Window subtitle display
window-subtitle = working-directory

# 窗口装饰类型（客户端自定义） / Window decoration type (client-side)
window-decoration = client

# 窗口高度（行数） / Window height (rows)
window-height = 30

# 窗口宽度（列数） / Window width (columns)
window-width = 120

# ----------------------------------------
# 背景效果 / Background Effects
# ----------------------------------------

# 背景透明度（0-1） / Background opacity (0-1)
background-opacity = 0.85

# 背景模糊程度 / Background blur intensity
background-blur = 20

# 未聚焦分割窗口的透明度 / Unfocused split opacity
unfocused-split-opacity = 0.8

# ----------------------------------------
# 主题与颜色 / Theme & Colors
# ----------------------------------------

# 颜色主题名称 / Color theme name
theme = Shades Of Purple

# 最低对比度要求（无障碍辅助） / Minimum contrast (accessibility)
minimum-contrast = 2.1

# 背景颜色 / Background color
background = #1e1d40

# 选中文本的背景颜色 / Selection background color
selection-background = #b362ff

# 选中文本的前景颜色 / Selection foreground color
selection-foreground = #c2c2c2

# 光标颜色 / Cursor color
cursor-color = #fad000

# 光标下的文本颜色 / Cursor text color
cursor-text = #98998e

# 光标透明度 / Cursor opacity
cursor-opacity = 0.9

# 颜色面板（16色调色板） / Color palette (16-color palette)
palette = 0=#000000
palette = 1=#d90429
palette = 2=#3ad900
palette = 3=#ffe700
palette = 4=#6943ff
palette = 5=#ff2c70
palette = 6=#00c5c7
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#f92a1c
palette = 10=#43d426
palette = 11=#f1d000
palette = 12=#6871ff
palette = 13=#ff77ff
palette = 14=#79e8fb
palette = 15=#ffffff

# ----------------------------------------
# 字体设置 / Font Settings
# ----------------------------------------

# 字体大小 / Font size
font-size = 12

# 默认字体 / Default font
font-family = Cascadia Code

# 粗体字体 / Bold font
font-family-bold = Cascadia Code

# 斜体字体 / Italic font
font-family-italic = Cascadia Code

# 粗斜体字体 / Bold italic font
font-family-bold-italic = Cascadia Code

# 粗体样式 / Bold style
font-style-bold = Bold

# 斜体样式 / Italic style
font-style-italic = Italic

# 粗斜体样式 / Bold italic style
font-style-bold-italic = Bold Italic

# ----------------------------------------
# 鼠标与界面 / Mouse & UI
# ----------------------------------------

# 打字时隐藏鼠标 / Hide mouse while typing
mouse-hide-while-typing = true

# GTK 工具栏样式（扁平） / GTK toolbar style (flat)
gtk-toolbar-style = flat

# GTK 禁用宽标签 / GTK disable wide tabs
gtk-wide-tabs = false

# GTK 显示标题栏 / GTK show titlebar
gtk-titlebar = true

# GTK 最大化时隐藏标题栏 / GTK hide titlebar when maximized
gtk-titlebar-hide-when-maximized = false

# ----------------------------------------
# macOS 特定设置 / macOS Specific Settings
# ----------------------------------------

# macOS 非原生全屏模式 / macOS non-native fullscreen mode
macos-non-native-fullscreen = visible-menu

# macOS 标题栏样式（标签式） / macOS titlebar style (tabs)
macos-titlebar-style = tabs

# ----------------------------------------
# 自动更新 / Auto Update
# ----------------------------------------

# 自动更新模式（检查更新） / Auto update mode (check for updates)
auto-update = check

# 自动更新通道（稳定版） / Auto update channel (stable)
auto-update-channel = stable

# ----------------------------------------
# 自定义着色器 / Custom Shader
# ----------------------------------------

# 自定义着色器文件路径（CRT效果，已注释） / Custom shader file path (CRT effect, commented)
#custom-shader = shaders/crt.glsl
